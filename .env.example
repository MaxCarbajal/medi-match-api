# Credenciales de medi-match-db. SUPABASE_SERVICE_ROLE_KEY es la secreta (no
# la publishable/anon) — bypassa RLS para leer proveedores_maestro/capacidades
# e insertar en asignaciones. Sácala de: Supabase Dashboard → tu proyecto →
# Project Settings → API Keys → "service_role". Nunca va al frontend.
SUPABASE_URL="https://tu-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx"
